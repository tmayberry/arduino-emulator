{
  "name": "arduino-emulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:check": "tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy:package": "npm run build && node scripts/package-deployment.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run format:check && npm run lint && npm test && npm run build && npm run worker:check",
    "worker:validate": "npm run worker:check && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "fflate": "^0.8.3",
    "JSCPP": "2.0.9",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.125.0"
  }
}
